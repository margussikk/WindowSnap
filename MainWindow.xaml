<Window x:Class="WindowSnap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowSnap" Height="690" Width="1000" MinHeight="620" MinWidth="900"
        Icon="Assets/WindowSnap.ico" Background="#F4F6F8" Foreground="#17212B"
        FontFamily="Segoe UI" ShowInTaskbar="True">

    <!--WindowStartupLocation="CenterScreen"-->
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#111C2D">
            <DockPanel Margin="24,30">
                <StackPanel DockPanel.Dock="Top">
                    <Border Width="48" Height="48" CornerRadius="14" Background="#3159D9" HorizontalAlignment="Left" Margin="0,0,0,22">
                        <TextBlock Text="↗" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="WINDOWSNAP" Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Window layout, made easy" Foreground="#9BAABD" FontSize="12" Margin="0,5,0,32"/>
                    <Border Background="#243249" CornerRadius="9" Padding="13,11" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#55D6A6" Margin="0,0,10,0"/>
                            <TextBlock Text="SNAPPING ACTIVE" Foreground="#EAF1FC" FontSize="11" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <TextBlock Text="HOW IT WORKS" Foreground="#718198" FontSize="10" FontWeight="Bold" Margin="4,25,0,12"/>
                    <TextBlock Text="Drag a window to a screen edge. WindowSnap aligns it when you finish moving it." TextWrapping="Wrap" Foreground="#C4CDDA" FontSize="13" LineHeight="20"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="WINDOW MANAGEMENT  ·  WINDOWS" Foreground="#718198" FontSize="10"/>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="42,34,42,36" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="WindowSnap" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Arrange your desktop with edge snapping and magnetic alignment." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,24"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="22">
                        <StackPanel><TextBlock Text="Edge snapping" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Choose how close a window must be to a screen edge." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,20"/>
                            <DockPanel><TextBlock Text="Snap distance" FontWeight="SemiBold"/><TextBlock x:Name="EdgeValue" DockPanel.Dock="Right" Text="32 px" Foreground="#3159D9" FontWeight="Bold"/></DockPanel>
                            <Slider x:Name="EdgeSlider" Minimum="12" Maximum="80" Value="16" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="SliderChanged" Margin="0,10,0,0"/>
                            <TextBlock Text="Corners create quarter-screen layouts; side edges create half-screen layouts." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="22">
                        <StackPanel><TextBlock Text="Magnetic alignment" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Line up moved windows with nearby windows." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,20"/>
                            <TextBlock Text="Moved and resized windows align with nearby neighbors when their edges come close." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="#E9EFFD" CornerRadius="14" Padding="22" Margin="0,0,0,16">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Quick guide" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Move a window and release near any screen edge to align it with that edge; its size stays the same. A corner release aligns the window with both nearby edges, without resizing it. Move or resize near another window to align their edges." TextWrapping="Wrap" Foreground="#43536B" Margin="0,8,10,0" LineHeight="20"/></StackPanel>
                        <Border Grid.Column="1" Width="118" Height="78" Background="#D6E2FF" CornerRadius="8" Padding="7">
                            <UniformGrid Rows="2" Columns="2"><Border Background="#3159D9" CornerRadius="4" Margin="2"/><Border Background="#7C9BF2" CornerRadius="4" Margin="2"/><Border Background="#7C9BF2" CornerRadius="4" Margin="2"/><Border Background="#3159D9" CornerRadius="4" Margin="2"/></UniformGrid>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock x:Name="StatusText" Text="Ready · Move a window to try snapping" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
